// ==============================================================================
// AQUAFLOW PRO - FIREBASE FIRESTORE SECURITY RULES
// ==============================================================================
// Apply these rules in your Firebase Console under Firestore Database -> Rules
// to ensure user data is strictly isolated and protected from unauthorized access.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User Workspaces (Batches, Presets, Student Lists)
    // Only the authenticated user can read or write their own documents.
    match /user_workspaces/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // User Profiles
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
  }
}
